# ==========================================
# Proofly Environment Configuration Template
# ==========================================

# Server
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api/v1
APP_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-key

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Polygon Blockchain (Amoy Testnet V1)
CHAIN_ID=80002
NETWORK_NAME=polygon-amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# Storage Layer (AWS S3 or Local fallback)
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=proofly-dev-certificates

# Email Service
EMAIL_FROM=no-reply@proofly.app
RESEND_API_KEY=
