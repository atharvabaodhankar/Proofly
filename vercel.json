{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/proofly.apk",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/services/api/public/$1"
    }
  ]
}
